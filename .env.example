# Backend Environment Variables
# Copy this file to backend/.env and fill in the values
# (для деплоя: корневой .env в /var/www/padel-russia читают scripts/cron-news.sh и docker-compose)

# JWT Secret Key (required)
JWT_SECRET=your-super-secret-jwt-key-here

# Google Places API Key (optional)
GOOGLE_PLACES_API_KEY=

# DeepSeek API Key — перевод новостей (scripts/cron-news.sh → .env в корне репо)
DEEPSEEK_API_KEY=

# Perplexity API Key (optional)
PERPLEXITY_API_KEY=

# Redis Configuration
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Node Environment
NODE_ENV=production